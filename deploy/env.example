# ============================================================================
# Variables de Pretty en el VPS. Dos archivos, ambos 600 y FUERA del repo:
#
#   /opt/pretty/env.compose  -> lo lee docker compose (--env-file)
#   /opt/pretty/env.api      -> lo carga el contenedor pretty-api (env_file)
# ============================================================================

# ---------- /opt/pretty/env.compose ----------
MSSQL_SA_PASSWORD=          # nueva, larga; solo para administrar (restaurar, respaldos). La API NO usa sa
TUNNEL_TOKEN=               # token del túnel de Cloudflare (Zero Trust > Networks > Tunnels)
PRETTY_API_ENV=/opt/pretty/env.api

# ---------- /opt/pretty/env.api ----------
# Base: la API entra con pretty_app (deploy/sql/crear_pretty_app.sql), nunca con sa.
# DB_SERVER y DB_PORT los pone el compose.
DB_USER=pretty_app
DB_PASSWORD=
DB_DATABASE=PSDATAFEB2024
NODE_ENV=production

# Sesiones. Se conserva el del servidor viejo en la fase 1; rotarlo en la fase 2.
JWT_SECRET=
JWT_EXPIRES_IN=

# Origen del front (el rewrite de Vercel reenvía el Origin del navegador)
CORS_ORIGINS=https://pretty-front.vercel.app

# WooCommerce: llave NUEVA creada el día del corte (la vieja se revoca).
WC_URL=https://prettymakeupcol.com
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
# Todas las tareas de Woo apagadas hasta que Eder las encienda una por una tras el corte
WOO_PUSH_ENABLED=false
WOO_IMPORT_ENABLED=false
WOO_RECONCILIACION_ENABLED=false
WOO_VENCIMIENTO_ENABLED=false

# Servicios externos (mismos valores del .env del servidor viejo; rotarlos en la fase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_CATALOG_BLOB_NAME=
AZURE_CATALOG_PUBLIC_URL=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
